rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@itsqmet\\.edu\\.ec$');
    }

    // Consulta puntual por cédula. No habilitar listados públicos.
    match /Estudiante/{cedula} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /matriculas/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /eleccionSedeComplexivo/{id} {
      // La app del estudiante necesita consultar si ya registró y crear una sola respuesta.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.cedula is string
        && request.resource.data.sedeComplexivo in ['Quito', 'Manta']
        && request.resource.data.periodoId == '2026-04__2026-09'
        && request.resource.data.confirmado == true;
      allow update, delete: if isAdmin();
    }
  }
}