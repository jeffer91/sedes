rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == '0401135306@itsqmet.edu.ec';
    }

    match /Estudiante/{cedula} {
      // La vista estudiante consulta un documento puntual por cédula.
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /matriculas/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /eleccionSedeComplexivo/{id} {
      // El estudiante puede consultar únicamente un registro conocido.
      allow get: if true;
      allow list: if isAdmin();

      // Solo se permite crear una respuesta coherente con un estudiante existente,
      // para el período activo y con un ID determinista. Al ser create, no puede
      // sobrescribirse una elección existente desde la vista estudiante.
      allow create: if
        request.resource.data.cedula is string
        && request.resource.data.sedeComplexivo in ['Quito', 'Manta']
        && request.resource.data.periodoId == '2026-04__2026-09'
        && request.resource.data.confirmado == true
        && id == request.resource.data.periodoId + '__' + request.resource.data.cedula
        && exists(/databases/$(database)/documents/Estudiante/$(request.resource.data.cedula))
        && request.resource.data.nombres
          == get(/databases/$(database)/documents/Estudiante/$(request.resource.data.cedula)).data.nombres
        && request.resource.data.nombreCarrera
          == get(/databases/$(database)/documents/Estudiante/$(request.resource.data.cedula)).data.nombreCarreraActual
        && request.resource.data.sedeAcademica
          == get(/databases/$(database)/documents/Estudiante/$(request.resource.data.cedula)).data.sede;

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
